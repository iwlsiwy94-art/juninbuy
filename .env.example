# Vercel > Project > Settings > Environment Variables 에 아래 5개를 입력합니다.

# Supabase > Project Settings > Data API 의 Project URL
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Supabase > Project Settings > API Keys 의 secret 키 (또는 service_role 키). 절대 외부에 공개하지 마십시오.
SUPABASE_SERVICE_ROLE_KEY=

# 로그인 유지용 비밀값. 아무 영문·숫자 40자 이상을 무작위로 입력합니다.
SESSION_SECRET=

# Anthropic Console 에서 발급한 API 키 (사진·PDF 자동 판독용)
ANTHROPIC_API_KEY=

# 판독에 쓸 Claude 모델 (비워 두면 claude-sonnet-5-5)
ANTHROPIC_MODEL=claude-sonnet-5-5
